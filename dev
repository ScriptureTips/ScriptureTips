#!/usr/bin/env bash
# Start or stop the local development stack (testing.md §2): ./dev up, ./dev down, ./dev logs,
# ./dev migrate (applies pending database migrations to the development database), ./dev site
# (builds the scripture.tips site's pages again, apps/site), ./dev launch [--app=NAME] [--print]
# (opens one of the sites in the browser), ./dev config.launchers (lists them as JSON, for
# LanProjectsControlPanel's launch buttons) and ./dev config.logs (lists the log sources as JSON,
# for its log viewer).
# The stack is served through Caddy as https://dev.scripturetips.com (the web app) and
# https://dev.scripture.tips (the data server), whose public DNS records point at this machine's
# network address. `./dev up --lan` listens on the network (to try it on a phone or tablet);
# plain `./dev up` listens on 127.0.0.1 only, which needs a hosts-file entry for both names.
# `./dev up --bind=IP` listens on that one address instead (for example the LAN address the names
# point at), so other projects can hold the same ports on other addresses (LanProjectsControlPanel
# runs it this way); `--local-bind=IP` moves the database and API ports (5432, 3001, normally
# 127.0.0.1) to another loopback address, such as 127.0.0.3, for the same reason. Never give
# --local-bind a network address: the development database and API would be open to it.
# The API and database stay on localhost. Runs on the host, since Docker isn't available inside
# the toolbox.
#
# Both sites need HTTPS: every device then gets a secure context, which the sign-in bot check
# needs (Web Crypto). Once .dev-certs/acme-dns.json holds the acme-dns account
# (infra/caddy/README.md), Caddy gets trusted Let's Encrypt certificates and renews them itself.
# Until then `./dev` makes a self-signed certificate, which a browser warns about once per site.
# .dev-certs/ isn't in git.
set -euo pipefail
cd "$(dirname "$0")"

export HOST_UID="$(id -u)" HOST_GID="$(id -g)"

# cspell:ignore newkey addext keyout elif

SITES=(dev.scripturetips.com dev.scripture.tips)

# Chooses the certificates: trusted ones through acme-dns when its account is there, otherwise
# a self-signed one, made if it's missing or doesn't cover the sites.
certificate() {
  if [[ -f .dev-certs/acme-dns.json ]]; then
    export DEV_TLS=acme-dns
    return
  fi
  export DEV_TLS=self-signed
  local names
  names="$(printf 'DNS:%s,' "${SITES[@]}")DNS:localhost"
  if [[ -f .dev-certs/cert.pem && "$(cat .dev-certs/names 2>/dev/null)" == "$names" ]]; then
    return
  fi
  mkdir -p .dev-certs
  ./toolbox openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
    -subj "/CN=ScriptureTips development" \
    -addext "subjectAltName=$names" -addext "extendedKeyUsage=serverAuth" \
    -keyout .dev-certs/key.pem -out .dev-certs/cert.pem 2>/dev/null
  echo "$names" >.dev-certs/names
}

SERVICES=(caddy web api api-data pdf-worker mailpit)

# The scripture.tips site's pages (apps/site), with the website plugin's script they serve: plain
# files in apps/site/dist, which Caddy serves. `./dev site` builds them again after a change.
site() {
  ./toolbox env CONTACT_EMAIL=help@scripturetips.com sh -c \
    'pnpm --filter @scripturetips/widget build && pnpm --filter @scripturetips/site build'
}

# The ways to open the project, one per line: app|title|URL|class (class optional). The first is the default. Each site
# keeps its real name, so its URL doesn't depend on how the stack was started. Mailpit's address
# does (127.0.0.1, the --bind address, or every address with --lan), so `mailpit` stands for the
# address Docker published it on, looked up when it's launched.
launchers() {
  cat <<'EOF'
web|Open dev.scripturetips.com in the browser|https://dev.scripturetips.com/
data|Open dev.scripture.tips in the browser|https://dev.scripture.tips/
mail|Open Mailpit (the caught emails) in the browser|mailpit|mail
EOF
}

# Mailpit's URL: where its port is published now, or the plain `./dev up` address when it isn't.
mailpit_url() {
  local published
  published="$(docker compose --profile dev port mailpit 8025 2>/dev/null | head -n1 || true)"
  published="${published/0.0.0.0:/127.0.0.1:}"
  echo "http://${published:-127.0.0.1:8025}/"
}

json_str() {
  local s=${1//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

# `./dev config.launchers`: the launchers as a JSON array, and nothing else on stdout.
config_launchers() {
  local first=1 app title url class
  printf '['
  while IFS='|' read -r app title url class; do
    [[ -n "$app" ]] || continue
    ((first)) || printf ','
    first=0
    printf '{"app":%s,"title":%s' "$(json_str "$app")" "$(json_str "$title")"
    [[ -z "$class" ]] || printf ',"class":%s' "$(json_str "$class")"
    printf '}'
  done < <(launchers)
  printf ']\n'
}

# `./dev config.logs`: the log sources as a JSON array, and nothing else on stdout. The project
# writes no log files (every service logs to its container's output), so each source is a command
# that follows that output; LanProjectsControlPanel runs it in this directory. The first is the one the viewer opens on.
config_logs() {
  cat <<'EOF'
[{"id":"containers","title":"All containers","cmd":"docker compose --profile dev logs -f --tail=200"},
 {"id":"api","title":"API (accounts and compilations)","cmd":"docker compose --profile dev logs -f --tail=200 api"},
 {"id":"api-data","title":"Data server API (scripture.tips)","cmd":"docker compose --profile dev logs -f --tail=200 api-data"},
 {"id":"web","title":"Web app","cmd":"docker compose --profile dev logs -f --tail=200 web"},
 {"id":"caddy","title":"Caddy (both sites, access log)","cmd":"docker compose --profile dev logs -f --tail=200 caddy"},
 {"id":"pdf-worker","title":"PDF worker","cmd":"docker compose --profile dev logs -f --tail=200 pdf-worker"}]
EOF
}

# `./dev launch [--app=NAME] [--print]`: prints the launcher's URL and opens it (not with --print).
launch() {
  local want="" print="" app title url class found=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --app=*) want="${1#--app=}"; shift ;;
      --app) want="${2:?--app needs a name}"; shift 2 ;;
      --print) print=1; shift ;;
      *) echo "./dev launch: unknown option $1" >&2; exit 2 ;;
    esac
  done
  while IFS='|' read -r app title url class; do
    [[ -n "$app" ]] || continue
    if [[ -z "$want" || "$app" == "$want" ]]; then
      if [[ "$url" == mailpit ]]; then url="$(mailpit_url)"; fi
      found="$url"
      break
    fi
  done < <(launchers)
  if [[ -z "$found" ]]; then
    echo "./dev launch: unknown app '$want'; choose from: $(launchers | cut -d'|' -f1 | paste -sd' ')" >&2
    exit 2
  fi
  echo "$found"
  [[ -n "$print" ]] && return 0
  if ! curl -s -o /dev/null --max-time 5 "$found"; then
    echo "./dev launch: the stack isn't running (./dev up first)" >&2
    exit 1
  fi
  if command -v xdg-open >/dev/null; then
    xdg-open "$found" >/dev/null 2>&1 &
  elif command -v open >/dev/null; then
    open "$found"
  fi
}

case "${1:-}" in
  up)
    shift
    lan="" bind="" local_bind=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --lan) lan=1 ;;
        --bind=*) bind="${1#*=}" ;;
        --bind) bind="${2:?--bind needs an address}"; shift ;;
        --local-bind=*) local_bind="${1#*=}" ;;
        --local-bind) local_bind="${2:?--local-bind needs an address}"; shift ;;
        *) echo "./dev up: unknown option $1" >&2; exit 1 ;;
      esac
      shift
    done
    if [[ -n "$lan" && -n "$bind" ]]; then
      echo "./dev up: use --lan or --bind, not both" >&2
      exit 1
    fi
    if [[ -n "$lan" ]]; then export LAN_BIND=0.0.0.0; fi
    if [[ -n "$bind" ]]; then export LAN_BIND="$bind"; fi
    if [[ -n "$local_bind" ]]; then export LOCAL_BIND="$local_bind"; fi
    certificate
    site
    docker compose --profile dev up -d --wait --force-recreate "${SERVICES[@]}"
    for site in "${SITES[@]}"; do echo "https://$site"; done
    if [[ -n "$bind" ]]; then
      echo "Mailpit: http://$bind:8025"
    elif [[ -n "$lan" ]]; then
      for a in $(hostname -I | tr ' ' '\n' | grep -E '^(192\.168|10)\.' || true); do
        echo "Mailpit: http://$a:8025"
      done
    else
      echo "Mailpit: http://127.0.0.1:8025"
    fi
    ;;
  down) exec docker compose --profile dev stop ;;
  logs) exec docker compose --profile dev logs -f "${@:2}" ;;
  migrate) exec ./toolbox pnpm --filter @scripturetips/db migrate ;;
  site) site ;;
  launch) shift; launch "$@" ;;
  config.launchers) config_launchers ;;
  config.logs) config_logs ;;
  config.*)
    echo "./dev: unknown config key: ${1#config.}" >&2
    exit 2
    ;;
  *)
    echo "Usage: ./dev up [--lan | --bind=IP] [--local-bind=IP] | down | logs [service] | migrate | site | launch [--app=NAME] [--print] | config.launchers | config.logs" >&2
    exit 1
    ;;
esac
